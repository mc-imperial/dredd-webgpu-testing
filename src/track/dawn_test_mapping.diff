+func saveMappingToFile(filename string, testmap map[string]string) {
+ 
+	//TODO: Make this file write cleaner
+
+	f, err := os.Create(filename)
+	if err != nil {
+		panic(err)
+	}
+
+	defer f.Close()
+	n1, err := f.WriteString("{")
+	if err != nil {
+		panic(err)
+	}
+	fmt.Printf("Write to file %d", n1)
+
+	var firstline bool = true
+	for k, v := range testmap {
+
+		line := string("\"" + strings.Replace(string(k),"\"","\\\"",-1) + "\" : \"" + v + "\"")
+		
+		if !firstline {
+			line = string(",\n" + line)
+		}
+
+		n2, err := f.WriteString(line)
+		if err != nil {
+			panic(err)
+		}
+		fmt.Printf("Write to file %d", n2)
+		firstline = false
+	}
+	n3, err := f.WriteString("}")
+	if err != nil {
+		panic(err)
+	}
+	fmt.Printf("Write to file %d", n3)
+
+	f.Sync()
+	
+}
