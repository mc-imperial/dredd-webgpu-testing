# Reduction image: the fuzzing image (Dredd-mutated and tracking Mesa, Dawn, wgslsmith)
# plus the reducers, C-Vise and Perses (wgslsmith's fork).
# Build: docker build -f Dockerfile.reduce -t dredd-webgpu-testing:reduce .
FROM dredd-webgpu-testing:wgslsmith

# C-Vise, and a JDK to run Perses (Bazel brings its own JDK for building it).
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates \
        cvise \
        openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

# Perses from wgslsmith's fork (it has the WGSL grammar).
# The fork has no .bazelversion and uses a WORKSPACE file, which Bazel 8+ no longer
# reads, so pin a Bazel from its era for Bazelisk to fetch. If 5.4.1 fails, try
# --build-arg PERSES_BAZEL_VERSION=6.5.0 (or 4.2.2).
# The fork's WORKSPACE also lists JCenter, which shut down; kotlinx-html 0.7.x is
# now only in JetBrains' own repository, so the sed below swaps that in.
# The fork's WGSL grammar predates literal suffixes (e.g. -809f) and 'const', so it is
# replaced with the updated copy in setup/patches/WGSL.g4 (changes marked [dredd]).
COPY setup/patches/WGSL.g4 /tmp/perses-WGSL.g4
ARG PERSES_BAZEL_VERSION=5.4.1
ENV USE_BAZEL_VERSION=${PERSES_BAZEL_VERSION}
RUN curl -fsSL -o /usr/local/bin/bazel \
        https://github.com/bazelbuild/bazelisk/releases/download/v1.20.0/bazelisk-linux-amd64 \
    && chmod +x /usr/local/bin/bazel \
    && git clone https://github.com/wgslsmith/perses /data/perses \
    && cd /data/perses \
    && sed -i 's#https://jcenter.bintray.com/\?#https://maven.pkg.jetbrains.space/public/p/kotlinx-html/maven#' WORKSPACE \
    && grep -q "maven.pkg.jetbrains.space" WORKSPACE \
    && cp /tmp/perses-WGSL.g4 src/org/perses/grammar/wgsl/WGSL.g4 \
    && bazel build //src/org/perses:perses_deploy.jar \
    && cp bazel-bin/src/org/perses/perses_deploy.jar /data/perses_deploy.jar \
    && bazel clean --expunge

ENV PERSES_JAR=/data/perses_deploy.jar

# Perses runs `rustfmt +1.56.1 --help` (and +1.57.0) at startup; without these, rustup
# downloads both toolchains inside every reduction container (several GB each time).
RUN rustup toolchain install 1.56.1 1.57.0 --profile minimal --component rustfmt